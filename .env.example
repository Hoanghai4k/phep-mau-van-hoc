# Environment Variables
# Copy this file to .env.local and fill in the values

# --- Public (exposed to browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (never exposed to browser) ---

# Production site URL (server-only, used for payment return/cancel/webhook URLs)
# On Vercel Production: set to https://your-domain.com
# On Vercel Preview: leave unset (falls back to VERCEL_URL automatically)
# Locally: leave unset (falls back to localhost:3000)
SITE_URL=

SUPABASE_SERVICE_ROLE_KEY=

# payOS Payment Provider
# Obtain from: https://my.payos.vn → Payment Channel → Integration Info
# All three are required for payment functionality.
# If absent, storefront still works but checkout returns "payment unavailable".
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Email sender address (Resend format: "Display Name <email>")
# Must be a verified sender domain on Resend.
EMAIL_FROM=Phép Màu Văn Học <noreply@phepmauvanhoc.com>

# Admin Authentication Secret
ADMIN_SECRET_KEY=

# Order Access Cookie Signing Secret (server-only)
# Signs HttpOnly cookies that authorize customers to view their order details.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production. Without it, order detail pages will reject all access.
ORDER_ACCESS_SECRET=

# Delivery Access Cookie Signing Secret (server-only)
# Signs HttpOnly cookies that authorize customers to download purchased files.
# SEPARATE from ORDER_ACCESS_SECRET — viewing and downloading use different authorization.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production.
DELIVERY_ACCESS_SECRET=

# My Orders Access Secret (server-only)
# Used for encrypting magic link tokens (AES-256-GCM) and signing My Orders session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production.
MY_ORDERS_ACCESS_SECRET=

# Resend Email Provider (server-only)
# Obtain from: https://resend.com → API Keys
# Required for delivery email sending.
RESEND_API_KEY=

# CloudConvert API Key (server-only)
# Used for generating PDF previews from DOCX files.
CLOUDCONVERT_API_KEY=

# Cloudflare R2 Product File Storage (server-only)
# Required when PRODUCT_FILE_STORAGE_PROVIDER=R2
# Create an R2 API token with Object Read/Write permissions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Product file storage provider: SUPABASE or R2
# Default: SUPABASE (existing behavior)
# Set to R2 to store new product files in Cloudflare R2.
PRODUCT_FILE_STORAGE_PROVIDER=SUPABASE